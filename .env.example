# Runtime storage and optional services. Keep real credentials out of git.
NUXT_DATA_DIR=.data
NUXT_TOKEN_KEY=
OPENAI_API_KEY=
OPENAI_DNS_MODEL=gpt-5.4-nano

# Production uses this public DSN by default. Set either explicitly to enable local monitoring.
# SENTRY_DSN=https://a7444553ec4443a990f21a5ba5ca60f7@error.cnnct.uk/14
# NUXT_PUBLIC_SENTRY_DSN=https://a7444553ec4443a990f21a5ba5ca60f7@error.cnnct.uk/14
# SENTRY_DISABLED=true
# NUXT_PUBLIC_SENTRY_DISABLED=true
# Errors and logs both go to GlitchTip; logs are filed under Service "dns-editor".
# Optional: the Host shown for the server's logs (defaults to the container's hostname).
# SENTRY_HOST_NAME=dns-editor-1

# Optional build-only token for source maps; never put it in runtime variables.
# SENTRY_AUTH_TOKEN=
