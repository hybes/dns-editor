# Runtime storage and optional services. Keep real credentials out of git.
NUXT_DATA_DIR=.data
NUXT_TOKEN_KEY=
OPENAI_API_KEY=
OPENAI_DNS_MODEL=gpt-5.4-nano

# GlitchTip. Only the Coolify deployment reports: the server when COOLIFY_FQDN, COOLIFY_URL or
# SOURCE_COMMIT is set (Coolify sets them), the browser when the page isn't on a local address.
# Local dev, local builds and previews, `docker run` and the tests send nothing.
# To test GlitchTip from your machine on purpose (events are tagged development):
# SENTRY_FORCE=1
# NUXT_PUBLIC_SENTRY_FORCE=1
# The project's public DSN is the default; setting one doesn't turn reporting on by itself.
# SENTRY_DSN=https://a7444553ec4443a990f21a5ba5ca60f7@error.cnnct.uk/14
# NUXT_PUBLIC_SENTRY_DSN=https://a7444553ec4443a990f21a5ba5ca60f7@error.cnnct.uk/14
# Environment: production on the deployment, development elsewhere. Override, e.g. for previews:
# SENTRY_ENVIRONMENT=preview
# NUXT_PUBLIC_SENTRY_ENVIRONMENT=preview
# Turn reporting off even on the deployment:
# SENTRY_DISABLED=true
# NUXT_PUBLIC_SENTRY_DISABLED=true
# Errors and logs both go to GlitchTip; logs are filed under Service "dns-editor".
# Optional: the Host shown for the server's logs (defaults to the container's hostname).
# SENTRY_HOST_NAME=dns-editor-1

# Optional build-only token for source maps; never put it in runtime variables.
# SENTRY_AUTH_TOKEN=
